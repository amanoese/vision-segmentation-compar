JEV_API_KEY=
# TYPESAFE_API_KEY can also be used for JEV.
FALAI_API_KEY=
# Fixed-query comparison does not require an LLM key.

# Per-frame visual Agent via OpenRouter (samAgentMode: openrouter).
OPENROUTER_API_KEY=
